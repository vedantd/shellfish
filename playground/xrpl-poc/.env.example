PRINCIPAL=1000
INTEREST_RATE_TENTHS_BPS=5500
PAYMENT_TOTAL=1
PAYMENT_INTERVAL_SEC=2592000
GRACE_PERIOD_SEC=604800
LOAN_ORIGINATION_FEE=100
LOAN_SERVICE_FEE=10
