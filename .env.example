# Network mode: LIVE_DEVNET | SIMULATED_LOAN
# Never label a simulated loan as on-chain lending.
NETWORK_MODE=SIMULATED_LOAN

# XRPL endpoint (used when NETWORK_MODE=LIVE_DEVNET)
XRPL_NETWORK=wss://s.devnet.rippletest.net:51233

# Local SQLite path (demo registry)
DATABASE_PATH=./data/shellfish.db

# API
API_HOST=127.0.0.1
API_PORT=3001

# Web (Vite)
VITE_API_BASE_URL=http://127.0.0.1:3001
