# LIVE_DEVNET product path — public IDs + seeds via env (never commit seeds).
# Copy to a local untracked file and fill from playground/Gita native E2E artifacts.

NETWORK_MODE=LIVE_DEVNET
XRPL_NETWORK=wss://s.devnet.rippletest.net:51233
DATABASE_PATH=./data/shellfish-live.db

# Required seeds (secret — local only)
SHELLFISH_BORROWER_SEED=
SHELLFISH_BROKER_SEED=

# Required public ledger identifiers (48-hex MPT issuance IDs)
SHELLFISH_LOAN_BROKER_ID=
SHELLFISH_LOAN_MPT_ID=
SHELLFISH_REP_MPT_ID=
SHELLFISH_REP_ISSUER_ACCOUNT=

# Optional
SHELLFISH_PRINCIPAL_MINOR=200000
SHELLFISH_MAX_STAKE_U=760000000
SHELLFISH_PAYMENT_TOTAL=1
SHELLFISH_PAYMENT_INTERVAL_SEC=2592000
SHELLFISH_GRACE_PERIOD_SEC=604800
SHELLFISH_LOAN_ORIGINATION_FEE=100
SHELLFISH_LOAN_SERVICE_FEE=10
# Set to 0 to open registry without connecting Devnet (inject ledger in tests)
SHELLFISH_LIVE_CONNECT=1
